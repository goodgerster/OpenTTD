{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 900
          }
        ]
      }
    ]
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": [
        "~/Library/Caches/ccache",
        "~/.cargo/registry",
        "~/.cache/nix"
      ]
    },
    "network": {
      "allowUnixSockets": [
        "/nix/var/nix/daemon-socket/socket"
      ],
      "allowedDomains": [
        "index.crates.io",
        "static.crates.io"
      ]
    }
  }
}
